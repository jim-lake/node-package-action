# Copy to .env and fill in. The e2e test uploads to real S3 and installs from
# the real public https base url. Never commit .env.
#
# S3 destination for the end-to-end test. The role running the test must be able
# to PutObject under this prefix, and objects under it must be readable over
# anonymous https (so `npm ci` can fetch them without AWS credentials).

# S3 bucket + path prefix for mirrored code/tarballs, no trailing slash.
E2E_S3_PREFIX=ares-staging-test-build/node-package-action-ci

# S3 bucket + path prefix for the npm mirror, no trailing slash.
E2E_S3_NPM_PREFIX=ares-staging-test-build/node-package-action-ci/npm

# Public https base url that maps to E2E_S3_NPM_PREFIX, no trailing slash.
# `npm ci` fetches rewritten `resolved` urls from here with no AWS auth.
E2E_S3_BASE_URL=https://ares-staging-test-build.s3.us-west-2.amazonaws.com/node-package-action-ci/npm

# AWS region for the bucket.
AWS_REGION=us-west-2
